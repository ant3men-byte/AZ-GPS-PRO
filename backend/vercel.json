{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/licensing.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/license/:path*",
      "destination": "/api/licensing?route=license/:path*"
    },
    {
      "source": "/admin/licenses/:path*",
      "destination": "/api/licensing?route=admin/licenses/:path*"
    },
    {
      "source": "/admin/licenses",
      "destination": "/api/licensing?route=admin/licenses"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}